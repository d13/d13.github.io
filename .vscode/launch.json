{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch site (dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Local\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Attach to Chrome",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src",
      "urlFilter": "http://localhost:4321/*",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Launch site + Chrome",
      "configurations": ["Launch site (dev)", "Attach to Chrome"],
      "stopAll": true
    }
  ]
}
