<section class="container demo" id="forms">
  <h2 class="demo__heading">Forms</h2>

  <div class="demo__block">
    <form>
      <fieldset>
        <legend>Form Legend</legend>

        <div>
          <label for="text-input">Text Input</label>
          <input type="text" id="text-input" placeholder="Text input placeholder" />
        </div>

        <div>
          <label for="email-input">Email Input</label>
          <input type="email" id="email-input" placeholder="email@example.com" />
        </div>

        <div>
          <label for="password-input">Password Input</label>
          <input type="password" id="password-input" placeholder="Password" />
        </div>

        <div>
          <label for="textarea">Textarea</label>
          <textarea id="textarea" rows="4" placeholder="Enter your message here"></textarea>
        </div>

        <div>
          <label for="select">Select Dropdown</label>
          <select id="select">
            <option value="">Select an option</option>
            <option value="1">Option 1</option>
            <option value="2">Option 2</option>
            <option value="3">Option 3</option>
          </select>
        </div>

        <div>
          <fieldset>
            <legend>Checkboxes</legend>
            <div>
              <input type="checkbox" id="checkbox1" name="checkbox" value="1" />
              <label for="checkbox1">Checkbox 1</label>
            </div>
            <div>
              <input type="checkbox" id="checkbox2" name="checkbox" value="2" />
              <label for="checkbox2">Checkbox 2</label>
            </div>
          </fieldset>
        </div>

        <div>
          <fieldset>
            <legend>Radio Buttons</legend>
            <div>
              <input type="radio" id="radio1" name="radio" value="1" />
              <label for="radio1">Radio 1</label>
            </div>
            <div>
              <input type="radio" id="radio2" name="radio" value="2" />
              <label for="radio2">Radio 2</label>
            </div>
          </fieldset>
        </div>

        <div>
          <label for="range">Range Input</label>
          <input type="range" id="range" min="0" max="100" value="50" />
        </div>

        <div>
          <button type="submit">Submit Button</button>
          <button type="reset">Reset Button</button>
          <button type="button">Regular Button</button>
        </div>
      </fieldset>
    </form>
  </div>
</section>

