---
import { caseStudies } from '../data/work.ts';
import WorkCard from './WorkCard.astro';
---

<section class="tease tease--work" aria-labelledby="work-tease-heading">
  <div class="container">
    <p class="tease__eyebrow">Work</p>
    <h2 id="work-tease-heading" class="tease__heading">
      TODO: Work tease headline.
    </h2>
    <p class="tease__body">
      TODO: Work tease blurb — what to expect across the case studies.
    </p>
    <div class="work-grid" role="list">
      {caseStudies.map((study) => (
        <div role="listitem">
          <WorkCard study={study} />
        </div>
      ))}
    </div>
    <p class="tease__cta">
      <a href="/work" class="link-cta">See all work <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>
