---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const brandHref = isHome ? '#top' : '/';

// Nav items: anchors on home, dedicated pages elsewhere.
// About and Connect are exceptions — always home-page anchors.
const navItems = [
  { sub: '01', label: 'About', href: isHome ? '#about' : '/#about' },
  { sub: '02', label: 'Story', href: isHome ? '#story' : '/story' },
  { sub: '03', label: 'Work', href: isHome ? '#work' : '/work' },
  { sub: '04', label: 'Connect', href: isHome ? '#connect' : '/#connect' },
];
---

<header class="header header--pinned" role="banner">
  <div class="header__row">
    <div class="header__group">
      <a href={brandHref} class="brand" aria-label="Keith Daulton home">
        <img src="media/branding/logo.svg" alt="" class="brand__mark" />
        <span>
          <span class="brand__name">Keith Daulton</span>
          <span class="brand__role">D13 // EST. 2000</span>
        </span>
      </a>
    </div>
    <nav class="header__group" id="nav" aria-label="Main Navigation">
      <ul class="nav-inline header__nav">
        {
          navItems.map(item => (
            <li>
              <a href={item.href}>
                <span class="sub">{item.sub}</span>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="https://github.com/d13" rel="noopener" target="_blank"><span class="sub">&#8599;</span>Code</a>
        </li>
        <li>
          <d-modes-menu></d-modes-menu>
        </li>
      </ul>
    </nav>
  </div>
</header>
