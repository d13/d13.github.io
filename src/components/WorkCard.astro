---
import type { CaseStudy } from '../data/work.ts';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const href = `/work/${study.slug}`;
---

<a class="work-card" href={href}>
  <span class="work-card__eyebrow">{study.context ?? 'Case study'}</span>
  <span class="work-card__title">{study.title}</span>
  <span class="work-card__blurb">{study.blurb}</span>
  <span class="work-card__cta" aria-hidden="true">View →</span>
</a>
