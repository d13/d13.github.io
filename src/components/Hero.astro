---
// Landing hero. Locked positioning copy — do not edit without sign-off.
const HEADLINE = 'An engineering leader who makes things people love to use.';
const SUBLINE = 'Fierce advocate for the people building products, and the people using them.';
---

<section class="hero" id="hero" aria-labelledby="hero-heading">
  <d-hero-image class="hero__media" aria-hidden="true"></d-hero-image>
  <div class="hero__content">
    <div class="container container--wide">
      <h1 id="hero-heading" class="hero__heading">{HEADLINE}</h1>
      <p class="hero__subline">{SUBLINE}</p>
    </div>
  </div>
</section>
