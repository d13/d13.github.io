---
import { site } from '../data/site.ts';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SkipLinks from '../components/SkipLinks.astro';
import '../styles/base.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  bodyClass?: string;
}

const {
  title = site.title,
  description = site.description,
  ogTitle,
  ogDescription,
  ogImage = site.og.defaultImage,
  bodyClass,
} = Astro.props;

const pageTitle = title === site.title ? title : `${title} · Keith Daulton`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="en" data-theme="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords} />
    <meta name="author" content={site.author} />

    <meta name="theme-color" content={site.themeColor} />
    <meta name="msapplication-TileColor" content={site.themeColor} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/meta/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/meta/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />

    <link rel="preconnect" href="https://p.typekit.net" />
    <link rel="preconnect" href="https://use.typekit.net" />
    <link rel="preload" href="https://use.typekit.net/bdx2zst.css" as="style" />

    <script>
      // Client-side entry: registers web components and wires shared utilities.
      // Astro bundles this script and emits the right `<script type="module">` tag.
      import '../scripts/main.ts';
    </script>
  </head>
  <body class={bodyClass}>
    <SkipLinks />
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
