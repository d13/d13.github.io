---
import { site } from '../data/site.ts';
import SkipLinks from '../components/SkipLinks.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/1-layers.css';
import '../styles/2-props-color.css';
import '../styles/2-props-sizing.css';
import '../styles/3-props-fonts.css';
import '../styles/3-props-spacing.css';
import '../styles/3-props-elevation.css';
import '../styles/3-props-motion.css';
import '../styles/4-base.css';
import '../styles/5-patterns.css';
import '../styles/6-utilities.css';
import '../styles/7-overrides.css';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  bodyClass?: string;
  mode?: 'auto' | 'light' | 'dark';
  isHome?: boolean;
}

const {
  title = site.title,
  description = site.description,
  ogTitle,
  ogDescription,
  ogImage = site.og.defaultImage,
  bodyClass,
  mode,
  isHome = false,
} = Astro.props;

const pageTitle = title === site.title ? title : `${title} · Keith Daulton`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="en" data-scheme={mode ?? 'auto'} data-accent="mix" data-fonts="loading">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords} />
    <meta name="author" content={site.author} />

    <meta name="theme-color" content={site.themeColor} />
    <meta name="msapplication-TileColor" content={site.themeColor} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/meta/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/meta/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />

    <link rel="preconnect" href="https://p.typekit.net" />
    <link rel="preconnect" href="https://use.typekit.net" />
    <link rel="stylesheet" href="https://use.typekit.net/bdx2zst.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />

    <script is:inline>
      // Hydrate persisted theme prefs before paint so accent/scheme don't
      // flash on load. Keys mirror the d-modes-menu component constants.
      (function () {
        try {
          var root = document.documentElement;
          var scheme = localStorage.getItem('d13:scheme');
          var accent = localStorage.getItem('d13:accent');
          if (scheme === 'light' || scheme === 'dark' || scheme === 'auto') {
            root.setAttribute('data-scheme', scheme);
          }
          if (accent === 'blue' || accent === 'red' || accent === 'mix') {
            root.setAttribute('data-accent', accent);
          }
        } catch (e) {
          /* storage unavailable */
        }
      })();
    </script>
    <script is:inline>
      // Flip <html data-fonts> to "ready" once web fonts resolve, so CSS
      // entrance animations don't get eaten by FOUT. 1.2s timeout guarantees
      // reveal even if the fonts.ready promise never resolves (offline, etc.).
      (function () {
        var root = document.documentElement;
        var reveal = function () {
          root.setAttribute('data-fonts', 'ready');
        };
        if (document.fonts && document.fonts.ready) {
          Promise.race([
            document.fonts.ready,
            new Promise(function (r) {
              setTimeout(r, 1200);
            }),
          ]).then(reveal);
        } else {
          reveal();
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <SkipLinks />
    <SiteHeader isHome={isHome} />
    <main id="main"><slot /></main>
    <SiteFooter isHome={isHome} />
  </body>
</html>
