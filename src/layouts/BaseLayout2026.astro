---
import { site } from '../data/site.ts';
import '../styles/1-layers.css';
import '../styles/2-props-color.css';
import '../styles/2-props-sizing.css';
import '../styles/3-props-fonts.css';
import '../styles/3-props-spacing.css';
import '../styles/3-props-elevation.css';
import '../styles/4-base.css';
import '../styles/5-patterns.css';
import '../styles/6-utilities.css';
import '../styles/7-overrides.css';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  bodyClass?: string;
  mode?: 'auto' | 'light' | 'dark';
}

const {
  title = site.title,
  description = site.description,
  ogTitle,
  ogDescription,
  ogImage = site.og.defaultImage,
  bodyClass,
  mode,
} = Astro.props;

const pageTitle = title === site.title ? title : `${title} · Keith Daulton`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="en" data-mode={mode ?? 'light'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords} />
    <meta name="author" content={site.author} />

    <meta name="theme-color" content={site.themeColor} />
    <meta name="msapplication-TileColor" content={site.themeColor} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/meta/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/meta/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />

    <link rel="preconnect" href="https://p.typekit.net" />
    <link rel="preconnect" href="https://use.typekit.net" />
    <link rel="preload" href="https://use.typekit.net/bdx2zst.css" as="style" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    /> -->

    <script>
      // Client-side entry: registers web components and wires shared utilities.
      // Astro bundles this script and emits the right `<script type="module">` tag.
      import '../scripts/main-2026.ts';
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
